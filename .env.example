# Copie para .env apenas no desenvolvimento. Gere os segredos antes de executar.
DJANGO_SECRET_KEY=
DJANGO_JWT_SIGNING_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=elo_saude
POSTGRES_USER=elo_saude
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5

# Defina DJANGO_SETTINGS_MODULE no processo, antes de iniciar o Django:
# config.settings.local | config.settings.staging | config.settings.production
# Staging/produção exigem variáveis externas e não leem este arquivo.
# Nesses ambientes, POSTGRES_SSLMODE deve ser require, verify-ca ou verify-full.
# Para verify-ca/verify-full, defina também POSTGRES_SSLROOTCERT.
# DJANGO_TRUST_PROXY_SSL_HEADER=false (ative apenas com proxy confiável)
